{
  "name": "rs1-sqlite-editor",
  "version": "1.0.0",
  "description": "A browser-based SQLite editor: open, edit, query and export databases entirely client-side with sql.js.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=app.min.js",
    "build:css": "cleancss -o styles.min.css styles.css",
    "serve": "python3 -m http.server 8000",
    "test": "node tests/shortcuts.test.mjs"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}
